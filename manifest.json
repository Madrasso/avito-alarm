{
  "manifest_version": 3,
  "name": "Avito Alarm",
  "description": "Повторяет звуковое уведомление о новых сообщениях Авито до их прочтения.",
  "version": "1.2.3",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.avito.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "64": "assets/icons/icon-64.png",
    "256": "assets/icons/icon-256.png"
  },
  "action": {
    "default_title": "Avito Alarm",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/IBMPlexSans-Regular.ttf",
        "assets/fonts/IBMPlexSans-SemiBold.ttf",
        "assets/fonts/IBMPlexMono-Medium.ttf"
      ],
      "matches": [
        "https://www.avito.ru/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.avito.ru/*"
      ],
      "js": [
        "lib/message-state.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
